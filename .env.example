# ============================================================
# Machine-specific settings for docker compose.
# Copy to .env (not versioned) and adjust the path:
#   cp .env.example .env
# ============================================================

# Host folder with dataset.db, metadata.json, normalizer.json.
# Mounted at /data in the container and passed to train.py as --data-dir.
# Examples:
#   Windows (PowerShell/CMD):  DATASET_DIR=D:/datasets/deforming_plate_s10
#   WSL2 (recommended, fast):  DATASET_DIR=/home/<user>/datasets/deforming_plate_s10
#   WSL2 on drive D:           DATASET_DIR=/mnt/d/datasets/deforming_plate_s10
DATASET_DIR=./data/deforming_plate_s10_small

# Training config (path relative to the repository). Default: the example
# config. Own configs go into configs/, which is mounted into the container:
#   CONFIG=configs/my_run.toml
# CONFIG=config.example.toml
